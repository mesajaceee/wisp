{
	"schemaVersion": 1,
	"id": "wisp",
	"version": "${version}",
	"name": "wisp",
	"description": "wisp it!",
	"authors": [
		"fracta7"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/fracta7/wisp"
	},
	"license": "CC0-1.0",
	"icon": "assets/wisp/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.mesa.wisp.Wisp",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.mesa.wisp.WispClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"wisp.mixins.json",
		{
			"config": "wisp.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}